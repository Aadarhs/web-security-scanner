# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./database/scanner.db

# Scanner Settings
SCAN_TIMEOUT=30000
MAX_CONCURRENT_SCANS=3
USER_AGENT=WebSecurityScanner/2.0

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Credentials (change immediately in production)
ADMIN_EMAIL=admin@securityscanner.local
ADMIN_PASSWORD=Admin@123456

# API Enrichment (optional - enriches scan results with CVE/CWE data from NVD)
API_ENRICHMENT_ENABLED=true

# AI Analysis (optional - requires API key or local Ollama)
AI_ANALYSIS_ENABLED=false
LLM_ENABLED=false
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
# OPENAI_API_KEY=sk-your-key-here
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=codellama

# Optional: OWASP ZAP Integration
ZAP_API_KEY=
ZAP_HOST=localhost
ZAP_PORT=8080

# Optional: Burp Suite Integration
BURP_PROXY_HOST=localhost
BURP_PROXY_PORT=8080